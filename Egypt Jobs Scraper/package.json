{
  "name": "egypt-jobs-scraper",
  "version": "1.0.0",
  "description": "Hire Q - Egypt Job Aggregator & Career Map Platform",
  "main": "index.js",
  "scripts": {
    "start": "tsc && node dist/GlobalManager.js",
    "start:linkedin": "tsc && node dist/LinkedInManager.js",
    "start:linkedin:smart": "tsc && SPLIT_MODE=smart node dist/LinkedInManager.js",
    "start:linkedin:raw": "tsc && SPLIT_MODE=raw node dist/LinkedInManager.js",
    "start:indeed": "node node_modules/ts-node/dist/bin.js src/IndeedManager.ts",
    "start:glassdoor": "node node_modules/ts-node/dist/bin.js src/GlassdoorManager.ts",
    "start:indeed:v4": "tsc && xvfb-run -a node dist/IndeedManagerV4.js",
    "start:indeed:v5": "tsc && INDEED_PY_STARTUP_TIMEOUT_MS=180000 xvfb-run -a -s \"-screen 0 1920x1080x24\" node dist/IndeedManagerV5.js",
    "start:indeed:v5:dry": "tsc && DRY_RUN=1 xvfb-run -a -s \"-screen 0 1920x1080x24\" node dist/IndeedManagerV5.js",
    "start:indeed:dry": "tsc && DRY_RUN=1 LIMIT_KEYWORDS=2 LIMIT_CITIES=2 LIMIT_PAGES=2 xvfb-run -a node dist/IndeedManagerV4.js",
    "init:db": "ts-node src/database/init_db.ts",
    "ingest": "ts-node src/ingest_jobs.ts",
    "ingest:batch": "npx tsx src/ingestion/index.ts",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "next dev",
    "build": "next build",
    "start:web": "next start",
    "start:forasna": "tsc && node dist/ForasnaManager.js",
    "start:bayt": "tsc && node dist/BaytManager.js",
    "start:tanqeeb": "node node_modules/ts-node/dist/bin.js src/TanqeebManager.ts",
    "salary:sync": "node node_modules/ts-node/dist/bin.js src/utils/SalaryEstimationEngine.ts",
    "salary:scrape": "node node_modules/ts-node/dist/bin.js src/scrapers/salary/PaylabSalaryScraper.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.6.0",
    "@types/pg": "^8.16.0",
    "@types/xml2js": "^0.4.14",
    "autoprefixer": "^10.4.20",
    "axios": "^1.13.2",
    "bull": "^4.16.5",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "csv-stringify": "^6.8.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.6.0",
    "got-scraping": "^4.2.1",
    "next": "^15.3.0",
    "pg": "^8.18.0",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "postcss": "^8.5.3",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.6.0",
    "typescript": "^5.9.3"
  }
}
