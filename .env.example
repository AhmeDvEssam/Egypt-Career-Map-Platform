# ==============================================================================
# HIRE Q PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# --- Database Configuration ---
DATABASE_URL=postgresql://egypt_jobs:egypt_jobs_2026@localhost:5432/egypt_jobs_db
SQLITE_FALLBACK_URL=sqlite:///jobs.db

# --- Server Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
STREAMLIT_PORT=8501

# --- LLM Provider API Keys (Fill in what you use) ---
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# --- Next.js Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_if_needed
