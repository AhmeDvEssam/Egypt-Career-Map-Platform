{
  "manifest_version": 3,
  "name": "HireQ Auto-Fill Assistant",
  "version": "1.0.0",
  "description": "Auto-fill ATS job applications (Workday, Pinpoint HQ, Concentrix, Lever) with 100% verified HireQ Vault answers.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3005/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "HireQ Auto-Fill Assistant"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
